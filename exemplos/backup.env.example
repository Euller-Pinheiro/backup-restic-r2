# /etc/backup-restic/backup.env  (chmod 600, dono root)

# --- Cloudflare R2 (compatível com S3) ---------------------------------------
# Painel Cloudflare > R2 > crie um bucket por servidor (ex.: backup-servidor1)
# > Manage R2 API Tokens > "Object Read & Write" restrito a ESSE bucket.
# Use um bucket e um token por servidor: se um servidor for invadido, o invasor
# só alcança o backup dele, não o dos outros.
RESTIC_REPOSITORY=s3:https://<ID-DA-CONTA>.r2.cloudflarestorage.com/<nome-do-bucket>
AWS_ACCESS_KEY_ID=<access key do token R2>
AWS_SECRET_ACCESS_KEY=<secret do token R2>
AWS_DEFAULT_REGION=auto

# Senha que cifra o repositório. Guarde uma cópia FORA do servidor (e fora do seu
# cofre de senhas, se o cofre estiver neste servidor): sem ela não há restauração.
RESTIC_PASSWORD_FILE=/etc/backup-restic/restic-password

# --- O que entra no backup (além dos dumps) — separado por espaço ------------
BACKUP_PATHS="/etc /opt /var/www"

# --- Retenção ----------------------------------------------------------------
KEEP_LAST=3
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# --- Aviso pelo Telegram (opcional) ------------------------------------------
# 1. No Telegram, fale com o @BotFather, mande /newbot e copie o token.
# 2. Mande qualquer mensagem para o bot (ou adicione o bot ao grupo da equipe).
# 3. Descubra o chat_id em https://api.telegram.org/bot<TOKEN>/getUpdates
#    (campo "chat":{"id":...}; grupos têm id negativo).
# 4. Teste:  sudo backup-notify.sh teste "funcionou"
# Sem as duas linhas abaixo, nenhum aviso é enviado.
# TELEGRAM_BOT_TOKEN=<token do bot>
# TELEGRAM_CHAT_ID=<id do chat ou grupo>
# NOTIFY_ON=falha          # falha (padrão) | sempre | desligado
# NOTIFY_HOST=web01        # nome que aparece no aviso (padrão: hostname -s)

# --- Opcional ----------------------------------------------------------------
# DUMP_DIR=/var/backups/restic-dumps
# CHECK_SUBSET=10%
# MYSQLDUMP="mysqldump --defaults-extra-file=/etc/backup-restic/my.cnf"
# RESTAURAR_EM=/var/tmp     # onde o backup-restaurar.sh cria a pasta de restauração
